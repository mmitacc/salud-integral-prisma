// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated-client"
}

datasource db {
  provider = "postgresql"
}

// Esquemas para la Base de datos
// ------------------- paciente ------------------ //
model Paciente {
  id              Int      @id @default(autoincrement())
  nombres         String   @db.VarChar(100)
  apellidos       String   @db.VarChar(100)
  telefono        String   @db.VarChar(20)
  /// @zod.string({ required_error: "El email es obligatorio" }).email({ message: "El formato del correo electrónico no es válido" })
  email           String   @unique @db.VarChar(150)
  masculino       Boolean  @default(true)
  fechanacimiento DateTime @db.Date
  tiposangre      String   @default("RHO+") @db.VarChar(5)
  alergias        String   @default("Ninguna") @db.Text
  registerdate    DateTime @default(now())
  deleted         Boolean  @default(false)

  // Relaciones inversas
  historiales Historial[]
  consultas   Consulta[]

  @@map("paciente")
}

// ------------------- historial ------------------ //
model Historial {
  id           Int      @id @default(autoincrement())
  id_paciente  Int
  motivo       String   @db.Text
  antecedentes String?  @db.Text
  triaje       String   @db.Text
  diagnostico  String?  @db.Text
  tratamiento  String?  @db.Text
  receta       String?  @db.Text
  registerdate DateTime @default(now())
  deleted      Boolean  @default(false)

  // Relación: Un historial pertenece a un paciente
  paciente Paciente @relation(fields: [id_paciente], references: [id], onDelete: Restrict)

  @@map("historial")
}

// Definicion de los 3 estados de: estado en 'cita'
enum EstadoCita {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

model Consulta {
  id           Int        @id @default(autoincrement())
  id_paciente  Int
  id_medico    Int
  estado       EstadoCita @default(PROGRAMADA)
  citadate     DateTime   @db.Timestamp
  costo        Decimal    @default(50.0) @db.Decimal(10, 2)
  registerdate DateTime   @default(now())
  deleted      Boolean    @default(false)

  // Relaciones
  paciente Paciente @relation(fields: [id_paciente], references: [id], onDelete: Restrict)
  medico   Medico   @relation(fields: [id_medico], references: [id], onDelete: Restrict)

  @@map("consulta")
}

model Medico {
  id              Int      @id @default(autoincrement())
  id_especialidad Int
  id_usuario      Int      @unique
  nombres         String   @db.VarChar(100)
  apellidos       String   @db.VarChar(100)
  telefono        String   @db.VarChar(20)
  /// @zod.string({ required_error: "El email es obligatorio" }).email({ message: "El formato del correo electrónico no es válido" })
  email           String   @unique @db.VarChar(150)
  masculino       Boolean  @default(true)
  fechanacimiento DateTime @db.Date
  registerdate    DateTime @default(now())
  deleted         Boolean  @default(false)

  // Relaciones
  especialidad Especialidad @relation(fields: [id_especialidad], references: [id], onDelete: Restrict)
  consultas    Consulta[]
  usuario      Usuario      @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  @@map("medico")
}

model Especialidad {
  id           Int      @id @default(autoincrement())
  tipo         String   @db.VarChar(100)
  registerdate DateTime @default(now())
  deleted      Boolean  @default(false)

  // Relaciones inversas
  medicos Medico[]

  @@map("especialidad")
}

// AUTENTICACIONES PARA ACCESO A LOS ENDPOINTS

enum Role {
  RECEPCIONISTA
  MEDICO
  GERENCIA
  ADMIN
}

model Usuario {
  id           Int      @id @default(autoincrement())
  /// @zod.string({ required_error: "El email es obligatorio" }).email({ message: "El formato del correo electrónico no es válido" })
  email        String   @unique
  password     String   @db.VarChar(100)
  role         Role
  username     String   @unique @db.VarChar(50)
  registerdate DateTime @default(now())
  deleted      Boolean  @default(false)

  // Relaciones inversas
  medico Medico?

  @@map("usuario")
}

// Generador automatio de Schemas con Prisma y Zod
generator zod {
  provider = "prisma-zod-generator"
  output   = "./generated-zod"
}
