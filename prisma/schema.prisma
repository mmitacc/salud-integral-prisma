// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated-client"
}

datasource db {
  provider = "postgresql"
}

// Esquemas para la Base de datos
// ------------------- paciente ------------------ //
model Paciente {
  id         Int      @id @default(autoincrement())
  nombres    String   @db.VarChar(100)
  apellidos  String   @db.VarChar(100)
  telefono   String   @db.VarChar(20)
  email      String   @unique @db.VarChar(150)
  masculino  Boolean  @default(true)
  fecha_nac  DateTime @db.Date
  tipoSangre String   @default("RHO+") @map("tipo_sangre") @db.VarChar(5)
  alergias   String   @default("Ninguna") @db.Text
  creado     DateTime @default(now())

  // Relaciones inversas
  historiales Historial[]
  citas       Cita[]

  @@map("paciente")
}

// ------------------- historial ------------------ //
model Historial {
  id           Int      @id @default(autoincrement())
  idPaciente   Int      @map("id_paciente")
  fecha        DateTime @default(now())
  motivo       String   @db.Text
  antecedentes String?  @db.Text
  triaje       String   @db.Text
  diagnostico  String?  @db.Text
  tratamiento  String?  @db.Text
  receta       String?  @db.Text

  // Relación: Un historial pertenece a un paciente
  paciente Paciente @relation(fields: [idPaciente], references: [id], onDelete: Restrict)

  @@map("historial")
}

// Definicion de los 3 estados de: estado en 'cita'
enum EstadoCita {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

// ------------------- cita ------------------ //
model Cita {
  id          Int        @id @default(autoincrement())
  idPaciente  Int        @map("id_paciente")
  fecha       DateTime   @default(now())
  estado      EstadoCita @default(PROGRAMADA)
  pagoInicial Decimal    @default(0.0) @map("pago_inicial") @db.Decimal(10, 2)

  // Relación: Una cita pertenece a un paciente
  paciente Paciente @relation(fields: [idPaciente], references: [id], onDelete: Restrict)

  // Relaciones inversas
  consultas Consulta[]

  @@map("cita")
}

model Consulta {
  id       Int      @id @default(autoincrement())
  idCita   Int      @map("id_cita")
  idMedico Int      @map("id_medico")
  fecha    DateTime @db.Date()
  horario  DateTime @db.Time()
  costo    Decimal  @default(50.0) @db.Decimal(10, 2)
  creado   DateTime @default(now())

  // Relaciones
  cita   Cita   @relation(fields: [idCita], references: [id], onDelete: Restrict)
  medico Medico @relation(fields: [idMedico], references: [id], onDelete: Restrict)

  @@map("consulta")
}

model Medico {
  id             Int      @id @default(autoincrement())
  idEspecialidad Int      @map("id_especialidad")
  nombres        String   @db.VarChar(100)
  apellidos      String   @db.VarChar(100)
  telefono       String   @db.VarChar(20)
  email          String   @unique @db.VarChar(150)
  masculino      Boolean  @default(true)
  fechaNac       DateTime @map("fecha_nac") @db.Date
  creado         DateTime @default(now())

  // Relaciones
  especialidad Especialidad @relation(fields: [idEspecialidad], references: [id], onDelete: Restrict)
  consultas    Consulta[]

  @@map("medico")
}

model Especialidad {
  id     Int      @id @default(autoincrement())
  tipo   String   @db.VarChar(100)
  creado DateTime @default(now())

  // Relaciones inversas
  medicos Medico[]

  @@map("especialidad")
}

// AUTENTICACIONES PARA ACCESO A LOS ENDPOINTS

enum Role {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String  @db.VarChar(100)
  role      Role
  nombres   String  @db.VarChar(100)
  apellidos String  @db.VarChar(100)
  activo    Boolean @default(true)

  @@map("users")
}

// Generador automatio de Schemas con Prisma y Zod
generator zod {
  provider = "prisma-zod-generator"
  output   = "./generated-zod"
}
